+    expect(await screen.findByText('无法从控制面读取交接记录或当前对象状态；未显示静态替代数据。')).toBeInTheDocument();
+    expect(screen.queryByText('需要在 Web 完成复杂处理。')).not.toBeInTheDocument();
+  });
+});
