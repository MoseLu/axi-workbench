{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini-Agent Desktop",
  "version": "0.1.0",
  "identifier": "com.miniagent.desktop",
  "build": {
    "active": true,
    "targets": ["nsis", "msi"],
    "devtools": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "AI Programming Assistant",
    "longDescription": "Mini-Agent Desktop is an AI-powered programming assistant that helps you write code, manage files, and execute terminal commands.",
    "copyright": "Copyright 2025 Mini-Agent Team",
    "category": "DeveloperTool",
    "publisher": "Mini-Agent"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mini-Agent Desktop",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765 https://api.openai.com https://api.anthropic.com"
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "license": null,
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installAfterFinish": true,
        "runAfterFinish": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Mini-Agent Desktop"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "shell": {
      "open": true
    },
    "fs": {
      "scope": {
        "allow": ["$APP/**", "$RESOURCE/**", "$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**"],
        "deny": []
      }
    }
  }
}
