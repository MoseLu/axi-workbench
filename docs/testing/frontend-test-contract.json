{
  "schema_version": "axi-rules.frontend-test-contract.v1",
  "project": "axi-workbench",
  "surfaces": [
    {
      "id": "workbench-web",
      "path": "apps/workbench",
      "framework": "react-vite",
      "runtime": "browser",
      "risk_tier": "A",
      "test_runner": "vitest",
      "commands": {"typecheck": "pnpm --filter @axi/workbench type-check", "lint": null, "test": "pnpm --filter @axi/workbench test", "coverage": "pnpm --filter @axi/workbench test:coverage", "build": "pnpm --filter @axi/workbench build", "e2e": "pnpm --dir apps/workbench e2e"},
      "required_layers": ["L0", "L1", "L2", "L3"],
      "critical_flows": ["session and route access", "admin navigation", "core control action"],
      "critical_flow_tests": {"session and route access": ["e2e/**/*.spec.ts", "src/lib/authGateway.test.ts"], "admin navigation": ["src/pages/admin/MenuList.test.ts"], "core control action": ["src/pages/admin/ControlPlaneState.behavior.test.tsx"]},
      "test_globs": ["src/**/*.test.ts", "src/**/*.test.tsx", "vite.apiProxyTarget.test.ts"],
      "e2e_globs": ["e2e/**/*.spec.ts"],
      "coverage": {"lines": 80, "branches": 70},
      "known_exceptions": [{"id": "workbench-web-coverage-floor", "status": "accepted", "reason": "The 2026-08-17 coverage run measured 21.73% lines and 74.62% branches because the package contains many admin routes and shell components without a component harness yet; critical login/navigation/control behavior is covered by L2 and Playwright evidence.", "next_action": "Add behavior tests for the remaining admin route families and raise the enforced 80/70 floor in the next Tier A coverage batch."}]
    },
    {
      "id": "workbench-mobile",
      "path": "apps/workbench-mobile",
      "framework": "react-vite",
      "runtime": "browser",
      "risk_tier": "A",
      "test_runner": "vitest",
      "commands": {"typecheck": "pnpm --filter @axi/workbench-mobile type-check", "lint": null, "test": "pnpm --filter @axi/workbench-mobile test", "coverage": "pnpm --filter @axi/workbench-mobile test:coverage", "build": "pnpm --filter @axi/workbench-mobile build", "e2e": "pnpm --dir apps/workbench-mobile e2e"},
      "required_layers": ["L0", "L1", "L2", "L3"],
      "critical_flows": ["mobile session", "navigation and tabs", "approval or scan action"],
      "critical_flow_tests": {"mobile session": ["e2e/**/*.spec.ts", "src/lib/qrLogin.test.ts"], "navigation and tabs": ["src/lib/navigation.test.ts"], "approval or scan action": ["src/lib/approvalScan.test.ts", "src/components/MobileProjectionState.behavior.test.tsx"]},
      "test_globs": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "e2e_globs": ["e2e/**/*.spec.ts"],
      "coverage": {"lines": 80, "branches": 70},
      "known_exceptions": [{"id": "workbench-mobile-coverage-floor", "status": "accepted", "reason": "The 2026-08-17 coverage run measured 20.27% lines and 68.39% branches because page-level mobile shells are not yet exercised by the component harness; mobile session, navigation, approval, and retry behavior have deterministic tests and Playwright coverage is declared.", "next_action": "Add page-level mobile behavior tests and raise the enforced 80/70 floor in the next Tier A coverage batch."}]
    },
    {
      "id": "devsvc-dashboard",
      "path": "apps/devsvc-dashboard",
      "framework": "react-vite-tauri",
      "runtime": "tauri-renderer",
      "risk_tier": "B",
      "test_runner": "node:test",
      "commands": {"typecheck": "pnpm --dir apps/devsvc-dashboard typecheck", "lint": null, "test": "pnpm --dir apps/devsvc-dashboard test", "coverage": null, "build": "pnpm --dir apps/devsvc-dashboard build", "e2e": null},
      "required_layers": ["L0", "L1", "L2"],
      "critical_flows": ["host navigation", "hosted app loading", "settings drawer"],
      "test_globs": ["scripts/*.test.mjs"],
      "e2e_globs": [],
      "coverage": {"lines": 70, "branches": 60},
      "critical_flow_tests": {"host navigation": ["scripts/navigation-icons.test.mjs"], "hosted app loading": ["scripts/hosted-webviews.test.mjs"], "settings drawer": ["scripts/settings-drawer-style.test.mjs"]},
      "known_exceptions": [{"id": "devsvc-coverage-and-component-tests", "status": "accepted", "reason": "The dashboard renderer is a Tauri shell whose native host is covered by runtime smoke; existing script and contract tests remain the deterministic local gate, while no aggregate coverage denominator is meaningful yet.", "next_action": "Add Tauri browser harness coverage and a package-level coverage report when the shell exposes a stable web test entrypoint."}]
    },
    {
      "id": "axi-coder",
      "path": "apps/axi-coder",
      "framework": "react-vite-tauri",
      "runtime": "tauri-renderer",
      "risk_tier": "B",
      "test_runner": "vitest",
      "commands": {"typecheck": "pnpm --dir apps/axi-coder typecheck", "lint": null, "test": "pnpm --dir apps/axi-coder test", "coverage": "pnpm --dir apps/axi-coder test -- --coverage", "build": "pnpm --dir apps/axi-coder build", "e2e": null},
      "required_layers": ["L0", "L1", "L2"],
      "critical_flows": ["project workspace", "provider selection", "completion state"],
      "critical_flow_tests": {"project workspace": ["src/features/product/axiCoderWorkbench.test.ts"], "provider selection": ["src/features/providers/axiProviderProfile.test.ts"], "completion state": ["src/features/product/axiCoderWorkspaceE2E.test.ts"]},
      "test_globs": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "e2e_globs": [],
      "coverage": {"lines": 70, "branches": 60},
      "known_exceptions": [{"id": "axi-coder-coverage", "status": "accepted", "reason": "The package has component/product tests but its current runner does not publish a stable coverage floor; the central audit records this as a deliberate Tier B exception.", "next_action": "Publish a package-level coverage report when the existing runner migration is complete."}]
    },
    {
      "id": "verification-inbox",
      "path": "apps/verification-inbox",
      "framework": "react-vite-tauri",
      "runtime": "tauri-renderer",
      "risk_tier": "B",
      "test_runner": "vitest",
      "commands": {"typecheck": "pnpm --dir apps/verification-inbox typecheck", "lint": null, "test": "pnpm --dir apps/verification-inbox test", "coverage": "pnpm --dir apps/verification-inbox test:coverage", "build": "pnpm --dir apps/verification-inbox build", "e2e": null},
      "required_layers": ["L0", "L2"],
      "critical_flows": ["verification inbox load", "OTP or verification action", "error recovery"],
      "critical_flow_tests": {"verification inbox load": ["src/App.test.tsx"], "OTP or verification action": ["src/App.test.tsx"], "error recovery": ["src/App.test.tsx"]},
      "test_globs": ["src/**/*.test.tsx"],
      "e2e_globs": [],
      "coverage": {"lines": 70, "branches": 60},
      "known_exceptions": [{"id": "verification-inbox-coverage-floor", "status": "accepted", "reason": "The 2026-08-17 coverage run measured 49.05% lines and 38.34% branches. The new behavior suite covers empty, filter, receive success, and receive error paths; remaining uncovered branches are native Tauri window controls, authorization, clipboard, and service-adapter boundaries that need a desktop harness.", "next_action": "Add a Tauri/WebDriver runtime harness and raise the enforced 70/60 floor after native controls and authorization flows are covered."}]
    }
  ]
}
