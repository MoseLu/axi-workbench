{
  "version": 2,
  "project": "axi-workbench",
  "name": "Axi Workbench",
  "status": "verified",
  "canonicalPath": "/Volumes/code/workspace/projects/axi-workbench",
  "kind": "pnpm multi-runtime monorepo",
  "lifecycle": "active",
  "owner": "Axi Core Projects",
  "summary": "Canonical AxiomaticWorld workbench for the six-layer control plane, dashboard applications, shared contracts, local services, AI integrations, fleet tooling, and app scaffolding.",
  "readOrder": [
    "AGENTS.md",
    "README.md",
    "docs/rules/epap-six-layer-sop.md",
    "docs/rules/axi-workbench-boundary-sop.md",
    "PRD.md"
  ],
  "entrypoints": [
    {
      "id": "web-portal",
      "path": "apps/web-portal/src/main.tsx",
      "purpose": "Primary browser portal for the workbench."
    },
    {
      "id": "control-plane",
      "path": "services/control-plane/src/server.mjs",
      "purpose": "Software-layer control API and managed AgentTask runtime surface."
    },
    {
      "id": "communication-gateway",
      "path": "services/communication-gateway/src/server.mjs",
      "purpose": "Communication-layer envelope routing and control-plane forwarding."
    },
    {
      "id": "workstation-contracts",
      "path": "packages/schemas/src/index.ts",
      "purpose": "Canonical IMEnvelope, AgentTask, and workstation contract exports."
    },
    {
      "id": "fleet-console",
      "path": "infra/fleet-console/scripts/fleetctl.py",
      "purpose": "Physical-service inventory and validation CLI."
    }
  ],
  "commands": {
    "setup": [
      "pnpm install"
    ],
    "start": [
      "pnpm dev",
      "pnpm dev:web",
      "pnpm --filter @axi/workstation-control-plane start",
      "pnpm --filter @axi/workstation-communication-gateway start"
    ],
    "health": [
      "pnpm --filter @axi/workstation-control-plane smoke",
      "python3 infra/fleet-console/scripts/fleetctl.py validate"
    ],
    "verify": [
      "pnpm type-check",
      "pnpm test",
      "pnpm test:workstation",
      "pnpm --dir apps/devsvc-dashboard typecheck",
      "pnpm --dir apps/axi-coder typecheck",
      "npm --prefix apps/verification-inbox run typecheck",
      "pnpm check:boundaries"
    ],
    "smoke": [
      "pnpm --filter @axi/workstation-control-plane smoke"
    ]
  },
  "environment": {
    "runtimes": [
      "Node.js >=18",
      "pnpm >=8",
      "TypeScript",
      "Go",
      "Python",
      "Java"
    ],
    "services": [
      "Control Plane",
      "Communication Gateway",
      "PostgreSQL",
      "Redis",
      "Kafka",
      "Qdrant",
      "MinIO",
      "Prometheus",
      "Grafana",
      "Jaeger"
    ],
    "variables": [
      {
        "name": "AXI_WORKSTATION_ROOT",
        "required": false,
        "secret": false,
        "source": "control-plane environment"
      },
      {
        "name": "AXI_WORKSTATION_CONTROL_CACHE_DIR",
        "required": false,
        "secret": false,
        "source": "control-plane environment"
      },
      {
        "name": "CC_CONNECT_MEMORY_DATABASE_URL",
        "required": false,
        "secret": true,
        "source": "local credentials or service environment"
      },
      {
        "name": "CODEX_BIN",
        "required": false,
        "secret": false,
        "source": "control-plane environment"
      },
      {
        "name": "AXI_AGENT_PLATFORM_URL",
        "required": false,
        "secret": false,
        "source": "control-plane environment"
      },
      {
        "name": "CONTROL_PLANE_PORT",
        "required": false,
        "secret": false,
        "source": "control-plane environment"
      },
      {
        "name": "AXI_WORKSTATION_CONTROL_PLANE_URL",
        "required": false,
        "secret": false,
        "source": "communication-gateway environment"
      },
      {
        "name": "COMMUNICATION_GATEWAY_PORT",
        "required": false,
        "secret": false,
        "source": "communication-gateway environment"
      }
    ]
  },
  "contracts": {
    "provides": [
      "IMEnvelope and AgentTask schemas",
      "Six-layer control-plane resource snapshots",
      "Communication gateway routing",
      "Axi Dashboard application surfaces",
      "Axi App CLI scaffolding"
    ],
    "consumes": [
      "Axi Agent Platform API when AXI_AGENT_PLATFORM_URL is configured",
      "CC-Connect memory database",
      "Codex CLI or Codex app-server runtime",
      "Local infrastructure services declared in docker-compose.yml"
    ],
    "files": [
      "packages/schemas/src/index.ts",
      "services/control-plane/src/control-plane.mjs",
      "services/communication-gateway/src/gateway.mjs",
      "docs/rules/epap-six-layer-sop.md",
      "docs/rules/epap-project-doc-agent-sop.md",
      "docs/rules/axi-workbench-boundary-sop.md",
      "scripts/check-workbench-boundaries.mjs"
    ]
  },
  "currentWork": {
