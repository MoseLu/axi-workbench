    "@axi/resource-api-docs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ioredis-mock": "^8.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
