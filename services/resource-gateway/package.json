{
  "name": "@axi/resource-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx --enable-source-maps src/server.ts",
    "dev": "tsx watch --enable-source-maps src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
