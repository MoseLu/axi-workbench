# Axi Workbench — Windows deploy .env template
#
# Status: DEVELOPMENT / STAGING PLACEHOLDER
# Scope:  Reference values for docker compose on the Windows host. Copy to
#         D:\enterprise-workspace\products\axi-workbench\.env.deploy and
#         replace every __REPLACE_ME__ before promoting to production.
#
# The values below are explicit placeholders. They must NOT be used as-is
# for production traffic. See docs/deployment/REMOTE-WINDOWS-WORKBENCH-
# DEPLOYMENT-TODO.md §5.1 for the list of secrets that must be supplied by
# a human operator, not generated or stored in this repository.

# ---------------------------------------------------------------------------
# 1. Runtime environment
# ---------------------------------------------------------------------------
ENVIRONMENT=staging                                  # development | staging | production
COMPOSE_PROJECT_NAME=axi-workbench-backend
COMPOSE_FILE=docker-compose.yml:docker-compose.backend.yml

# Where the Workbench UI will be served. This must be the public HTTPS
# origin the Mac app talks to via the Rust native gateway proxy.
GATEWAY_PUBLIC_BASE_URL=https://workbench.axiomaticworld.com
CORS_ALLOWED_ORIGINS=https://workbench.axiomaticworld.com

# ---------------------------------------------------------------------------
# 2. PostgreSQL
# ---------------------------------------------------------------------------
# Development / staging placeholder. The Windows host already owns a MySQL
# service on 3306; that is NOT Workbench. Workbench uses its own Postgres
# on 127.0.0.1:15432, exposed only to the host.
#
# Required from human:
#   - POSTGRES_PASSWORD (strong, rotated)
#   - per-service role passwords (axi_identity_app, axi_platform_app,
#     axi_workflow_app, axi_notification_app, axi_file_app, plus
#     migrator roles for each). Runtime roles must NOT own migration
#     privileges.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__REPLACE_ME_postgres_root__
POSTGRES_DB=epap

# ---------------------------------------------------------------------------
# 3. Redis
# ---------------------------------------------------------------------------
# No password in the placeholder; production must add requirepass and
# Redis ACLs. The data volume must be on the host's encrypted drive.
REDIS_PASSWORD=__REPLACE_ME_redis_password__

# ---------------------------------------------------------------------------
# 4. Inter-service internal tokens
# ---------------------------------------------------------------------------
# These tokens authenticate Gateway <-> downstream traffic on the Docker
# network. They are NEVER exposed to the public HTTPS origin. The
# placeholder value mirrors the existing development constant so the
# backend compose profile keeps working out of the box; production must
# replace each one with a unique 32+ byte random string.
GATEWAY_INTERNAL_TOKEN=__REPLACE_ME_random_32b__
GATEWAY_IDENTITY_INTERNAL_TOKEN=__REPLACE_ME_random_32b__
GATEWAY_PLATFORM_INTERNAL_TOKEN=__REPLACE_ME_random_32b__
GATEWAY_FILE_INTERNAL_TOKEN=__REPLACE_ME_random_32b__
GATEWAY_WORKFLOW_INTERNAL_TOKEN=__REPLACE_ME_random_32b__
GATEWAY_NOTIFICATION_INTERNAL_TOKEN=__REPLACE_ME_random_32b__
GATEWAY_CONTROL_PLANE_INTERNAL_TOKEN=__REPLACE_ME_random_32b__

IDENTITY_INTERNAL_SERVICE_TOKEN=__REPLACE_ME_random_32b__
PLATFORM_INTERNAL_SERVICE_TOKEN=__REPLACE_ME_random_32b__
WORKFLOW_INTERNAL_SERVICE_TOKEN=__REPLACE_ME_random_32b__
NOTIFICATION_INTERNAL_SERVICE_TOKEN=__REPLACE_ME_random_32b__
FILE_INTERNAL_SERVICE_TOKEN=__REPLACE_ME_random_32b__

# ---------------------------------------------------------------------------
# 5. Mail / SMTP
# ---------------------------------------------------------------------------
# Placeholder uses the bundled Mailpit sink so the staging compose stack
# keeps working without a real SMTP server. Production must point SMTP_*
# at the real provider and remove Mailpit from the stack.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=__REPLACE_ME_or_blank__
SMTP_PASSWORD=__REPLACE_ME_or_blank__
SMTP_USE_TLS=true
FROM_EMAIL=__REPLACE_ME_verified_sender__
IDENTITY_EMAIL_DELIVERY=smtp                            # NOT "log" in prod

# ---------------------------------------------------------------------------
# 6. OIDC / identity provider
# ---------------------------------------------------------------------------
# The Windows host may either keep the bundled Identity Adapter or
# federate to an external OIDC provider. Required from human:
#   - OIDC issuer URL (must be HTTPS, must support discovery)
#   - OIDC client_id / client_secret registered for the production app
#   - audience claim and the redirect URI matching
#     https://workbench.axiomaticworld.com/api/v1/auth/callback
OIDC_ISSUER=__REPLACE_ME_https_oidc_issuer__
OIDC_CLIENT_ID=__REPLACE_ME_oidc_client_id__
OIDC_CLIENT_SECRET=__REPLACE_ME_oidc_client_secret__
OIDC_AUDIENCE=https://workbench.axiomaticworld.com
OIDC_REDIRECT_URI=https://workbench.axiomaticworld.com/api/v1/auth/callback

# ---------------------------------------------------------------------------
# 7. Object storage
# ---------------------------------------------------------------------------
FILE_STORAGE_BACKEND=s3                                  # NOT "local" in prod
FILE_STORAGE_PATH=/var/lib/axi/files
FILE_VIRUS_SCAN_BACKEND=__REPLACE_ME_provider__          # NOT "disabled"
S3_ENDPOINT=__REPLACE_ME_https_s3_endpoint__
S3_BUCKET=__REPLACE_ME_bucket__
S3_ACCESS_KEY=__REPLACE_ME_access_key__
S3_SECRET_KEY=__REPLACE_ME_secret_key__
S3_REGION=__REPLACE_ME_region__

# ---------------------------------------------------------------------------
# 8. Mobile / pairing
# ---------------------------------------------------------------------------
# Required for the desktop QR login flow. Production must NOT use the
# development default token; generate a strong random and store it in
# the Windows host secret store.
AXI_MOBILE_PAIRING_ENABLED=true
AXI_MOBILE_OWNER_TOKEN=__REPLACE_ME_random_32b__
AXI_MOBILE_TOKEN_SECRET=__REPLACE_ME_random_32b__
AXI_MOBILE_GATEWAY_BASE_URL=https://workbench.axiomaticworld.com/api/v1/

# ---------------------------------------------------------------------------
# 9. Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info                                            # debug for staging
LOG_REDACT_KEYWORDS=password,token,secret,authorization,cookie,set-cookie
