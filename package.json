{
  "name": "axi-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "Axi Workbench - canonical workbench monorepo for control plane, dashboards, coder, docs/search, fleet, inbox, local assistants, and app CLI",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm run dev:workbench",
    "dev:mobile": "turbo run dev --filter=@axi/workbench-mobile",
    "dev:ui": "turbo run dev --filter=@axi/ui",
    "dev:dashboard": "pnpm --dir apps/devsvc-dashboard dev",
    "dev:coder": "pnpm --dir apps/axi-coder dev",
    "build": "turbo run build",
    "build:web": "pnpm run build:workbench",
    "build:mobile": "turbo run build --filter=@axi/workbench-mobile",
    "build:ui": "turbo run build --filter=@axi/ui",
    "build:schemas": "turbo run build --filter=@axi/workstation-contracts",
    "build:types": "turbo run build --filter=@axi/types",
    "build:utils": "turbo run build --filter=@axi/utils",
    "build:api-client": "turbo run build --filter=@axi/api-client",
    "test": "turbo run test",
    "test:workstation": "pnpm --filter @axi/workstation-contracts test && pnpm --filter @axi/workstation-communication-gateway test && pnpm --filter @axi/workstation-control-plane test",
    "test:mobile": "pnpm --filter @axi/workbench-mobile test",
    "check:boundaries": "node scripts/check-workbench-boundaries.mjs",
    "check:capabilities": "node scripts/verify-capability-inventory.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:cache": "turbo run clean:cache && rm -rf .turbo",
    "dev:workbench": "turbo run dev --filter=@axi/workbench --filter=@axi/workstation-control-plane",
    "build:workbench": "turbo run build --filter=@axi/workbench",
    "dev:desktop": "pnpm --filter @axi/workbench-desktop dev",
    "build:desktop": "pnpm --filter @axi/workbench-desktop verify:contracts && pnpm --filter @axi/workbench-desktop build",
    "build:desktop:remote": "pnpm --filter @axi/workbench-desktop verify:contracts && pnpm --filter @axi/workbench-desktop build",
    "build:desktop:local": "pnpm --filter @axi/workbench-desktop verify:contracts && pnpm --filter @axi/workbench-desktop build:local",
    "build:desktop:dmg": "pnpm --filter @axi/workbench-desktop verify:contracts && pnpm --filter @axi/workbench-desktop build:dmg",
    "build:desktop:remote:dmg": "pnpm --filter @axi/workbench-desktop verify:contracts && pnpm --filter @axi/workbench-desktop build:dmg",
    "build:desktop:local:dmg": "pnpm --filter @axi/workbench-desktop verify:contracts && pnpm --filter @axi/workbench-desktop build:local:dmg",
    "type-check:mobile": "pnpm --filter @axi/workbench-mobile type-check",
    "verify:ci": "node scripts/verify-ci-contracts.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
