{
  "name": "@axi/scaffold-runtime",
  "version": "1.0.0",
  "description": "CLI runtime, sync, doctor, install, and file orchestration for the Axi scaffold.",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@axi/scaffold-kit": "workspace:*",
    "@axi/scaffold-registry": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
