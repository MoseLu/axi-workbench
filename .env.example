# ============================================
# EPAP - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# ============================================

# ============================================
# Global
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
AXI_ENV=development

# ============================================
# API Gateway
# ============================================
API_GATEWAY_PORT=8088
GATEWAY_PORT=8080
API_GATEWAY_LOG_LEVEL=debug
# Leave empty for local development. In Kubernetes set the Collector's OTLP/HTTP
# endpoint (for example https://otel-collector.example:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_IDENTITY_INTERNAL_TOKEN=replace-with-a-long-random-value
GATEWAY_PLATFORM_INTERNAL_TOKEN=replace-with-a-different-long-random-value
OIDC_ISSUER_URL=https://id.example.test
OIDC_CLIENT_ID=axi-workbench-web
OIDC_CLIENT_SECRET=replace-in-kubernetes-secret
# API Bearer tokens must be minted for this resource server and carry every
# listed scope. Browser BFF sessions do not expose these tokens to JavaScript.
OIDC_API_AUDIENCE=axi-workbench-api
OIDC_REQUIRED_ACCESS_TOKEN_SCOPES=axi.api
OIDC_CALLBACK_URL=http://127.0.0.1:8088/api/v1/auth/oidc/callback
OIDC_ALLOWED_RETURN_URLS=http://127.0.0.1:5173/auth/callback,http://127.0.0.1:5174/auth/callback,http://localhost:5173/auth/callback,http://localhost:5174/auth/callback
SESSION_COOKIE_NAME=axi_session
SESSION_COOKIE_SECURE=false

# ============================================
# Auth Service
# ============================================
IDENTITY_ADAPTER_PORT=8081
IDENTITY_DATABASE_URL=postgresql://axi_identity_app:axi_identity_dev@localhost:5432/axi_identity?sslmode=disable
IDENTITY_REDIS_URL=redis://localhost:6379/1
IDENTITY_INTERNAL_SERVICE_TOKEN=replace-with-the-gateway-identity-internal-token
IDENTITY_PUBLIC_BASE_URL=http://127.0.0.1:8088
ZITADEL_ISSUER_URL=https://id.example.test
ZITADEL_CUSTOM_LOGIN_URL=https://id.example.test/ui/login
ZITADEL_WEBHOOK_SECRET=replace-with-a-long-random-value
IDENTITY_EMAIL_DELIVERY=log
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your-mailbox@example.com
SMTP_PASSWORD=use-an-app-password-not-your-login-password
SMTP_FROM=your-mailbox@example.com

# ============================================
# Core Service
# ============================================
PLATFORM_CORE_PORT=8082
PLATFORM_DATABASE_URL=postgresql://axi_platform_app:axi_platform_dev@localhost:5432/axi_platform?sslmode=disable
# Only the one-shot migration command receives the BYPASSRLS role. Never put
# this value in the running platform-core deployment.
PLATFORM_MIGRATION_DATABASE_URL=postgresql://axi_platform_migrator:axi_platform_migrator_dev@localhost:5432/axi_platform?sslmode=disable
PLATFORM_INTERNAL_SERVICE_TOKEN=replace-with-the-gateway-platform-internal-token
PLATFORM_OUTBOX_WORKER=false
PLATFORM_OUTBOX_POLL_INTERVAL=5s
PLATFORM_OUTBOX_DELIVERY_URL=

# ============================================
# Workflow Engine
# ============================================
WORKFLOW_SERVICE_PORT=8083
WORKFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epap_workflow
WORKFLOW_REDIS_URL=redis://localhost:6379/2
WORKFLOW_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================
# Notification Service
# ============================================
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epap_notification
NOTIFICATION_REDIS_URL=redis://localhost:6379/3
NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================
# File Service
# ============================================
FILE_SERVICE_PORT=8085
FILE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epap_files
FILE_S3_ENDPOINT=http://localhost:9000
FILE_S3_ACCESS_KEY=minioadmin
FILE_S3_SECRET_KEY=minioadmin
FILE_S3_BUCKET=epap-files

# ============================================
# Knowledge Base
# ============================================
KNOWLEDGE_BASE_PORT=8090
KNOWLEDGE_BASE_GRPC_PORT=9090
KNOWLEDGE_BASE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epap_knowledge
KNOWLEDGE_BASE_QDRANT_URL=http://localhost:6333
KNOWLEDGE_BASE_REDIS_URL=redis://localhost:6379/4

# ============================================
# Agent Platform
# ============================================
AGENT_PLATFORM_PORT=8091
AGENT_PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epap_agent
AGENT_PLATFORM_REDIS_URL=redis://localhost:6379/5
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# Frontend
# ============================================
# Keep browser requests relative so Web (5173) and mobile (5174) both use the
# Vite /api proxy in development. Each independently built production app must
# set this to the same HTTPS gateway origin, such as https://api.axi.example.com.
VITE_API_BASE_URL=
VITE_OIDC_START_URL=/api/v1/auth/oidc/start
VITE_WS_URL=ws://localhost:8088

# ============================================
# MinIO (Object Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=epap

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=

# ============================================
# Kafka
# ============================================
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092

# ============================================
# OpenAI (for embeddings)
# ============================================
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
