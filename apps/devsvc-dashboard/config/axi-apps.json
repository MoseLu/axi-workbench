[
  {
    "appId": "axi-fleet-console",
    "title": "Axi Fleet Console",
    "executionBoundary": {
      "owner": "Fleet Console（物理服务层）",
      "authorization": "Fleet 自身授权与高风险确认",
      "audit": "Fleet 操作审计",
      "fallback": "服务不可用时仅显示状态，不在 Host 复刻执行按钮"
    },
    "icon": "database",
    "cwd": "${workspaceRoot}/projects/axi-workbench/infra/fleet-console/dashboard",
    "startCommand": "${workspaceRoot}/scripts/run-node22-command.sh npm run dev -- --host 127.0.0.1 --port ${port} --strictPort",
    "packageManager": "npm",
    "defaultRoute": "/dashboard",
    "healthPath": "/",
    "routes": [
      "/dashboard",
      "/devices",
      "/services",
      "/projects",
      "/credentials"
    ],
    "menuGroups": [
      {
        "key": "operations",
        "label": "运维工作台",
        "icon": "app",
        "children": [
          {
            "key": "dashboard",
            "label": "仪表盘",
            "icon": "stats",
            "route": "/dashboard"
          },
          {
            "key": "devices",
            "label": "服务器管理",
            "icon": "device",
            "route": "/devices"
          },
          {
            "key": "services",
            "label": "服务管理",
            "icon": "component",
            "route": "/services"
          }
        ]
      },
      {
        "key": "governance",
        "label": "资产治理",
        "icon": "auth",
        "children": [
          {
            "key": "projects",
            "label": "项目管理",
            "icon": "workbench",
            "route": "/projects"
          },
          {
            "key": "credentials",
            "label": "凭证管理",
            "icon": "auth",
            "route": "/credentials"
          }
        ]
      }
    ],
    "capabilities": [
      "web",
      "ops",
      "dashboard"
    ],
    "hostedMode": true,
    "nativeFallback": false
  },
  {
    "appId": "axi-coder",
    "title": "Axi Coder",
    "executionBoundary": {
      "owner": "Axi Coder（受管开发运行时）",
      "authorization": "Coder 任务政策与运行时授权",
      "audit": "Coder 任务、工具与产物审计",
