    "icon": "workbench",
    "cwd": "${workspaceRoot}/projects/axi-workbench/apps/axi-coder",
    "startCommand": "${workspaceRoot}/scripts/run-node22-command.sh pnpm exec vite --host 127.0.0.1 --port ${port} --strictPort",
