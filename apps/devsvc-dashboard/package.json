    "@axi/observability-react-hooks": "link:../../../../foundation/axi-observability/react-hooks",
    "@axi/observability-web": "workspace:*",
    "@axi/presets": "link:../../../../foundation/axi-ui/packages/presets",
    "@axi/settings": "link:../../../../foundation/axi-ui/packages/settings",
    "@axi/shell": "link:../../../../foundation/axi-ui/packages/shell",
    "@axi/tokens": "link:../../../../foundation/axi-ui/packages/tokens",
    "@axi/widgets": "link:../../../../foundation/axi-ui/packages/widgets",
    "@tanstack/react-query": "^5.51.0",
    "@tauri-apps/api": "^2.11.0",
    "@vitejs/plugin-react": "^5.1.1",
    "antd": "^6.4.3",
    "i18next": "^26.2.0",
    "lucide-react": "^0.561.0",
