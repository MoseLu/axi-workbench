{
  "name": "@axi/devsvc-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "PATH=\"$HOME/.local/share/micromamba/envs/ielts-mac-runtime/bin:$PATH\" node node_modules/vite/bin/vite.js build",
    "check:file-lines": "node scripts/check-file-lines.mjs",
    "check:file-lines:push": "node scripts/check-file-lines.mjs --push",
    "check:file-lines:staged": "node scripts/check-file-lines.mjs --staged",
    "dev": "PATH=\"$HOME/.local/share/micromamba/envs/ielts-mac-runtime/bin:$PATH\" vite --host 127.0.0.1 --port 17889 --strictPort",
    "drift-check": "node scripts/drift-check.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "preview": "PATH=\"$HOME/.local/share/micromamba/envs/ielts-mac-runtime/bin:$PATH\" vite preview --host 127.0.0.1 --port 17890 --strictPort",
    "tauri": "tauri",
    "test": "node --import ./scripts/test-loader.mjs --test scripts/*.test.mjs",
    "test:legacy": "node --test scripts/*.test.mjs",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@axi/addons": "link:../../../../foundation/axi-ui/packages/addons",
    "@axi/core": "link:../../../../foundation/axi-ui/packages/core",
