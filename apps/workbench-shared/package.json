{
  "name": "@axi/workbench-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./format": "./src/format/index.ts",
    "./types": "./src/types/index.ts"
  },
  "description": "Cross-surface utilities shared by web, mobile, and desktop workbench clients. Pure helpers — no UI, no platform APIs.",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@axi/workstation-contracts": "workspace:*",
    "@epap/api-client": "workspace:*",
    "@epap/types": "workspace:*",
    "@epap/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^18.2.43",
    "jsdom": "^29.1.1",
    "react": "18.2.0",
    "react-dom": "18.3.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}