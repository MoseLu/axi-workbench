# LAN / mobile App access example (do not commit real values)
#
# Copy this file to `apps/workbench/.env.local` (gitignored) and replace
# the placeholder LAN IP with the actual address printed by `ifconfig` /
# `ipconfig getifaddr en0` on the development Mac.
#
# Flow when a phone App reaches the dev server:
#   phone App → Vite :5177 (assets) → same-origin proxy
#   phone App → Gateway :8787 (data) → explicit Origin allowlist
#
# Both Vite and Gateway must be bound to 0.0.0.0; the proxy strips the
# Origin header for proxied requests so the gateway treats them as
# same-origin. Direct Gateway calls from a phone App MUST carry an
# x-request-id (gateway-client.ts mints one automatically) and an Origin
# header that matches GATEWAY_CORS_ORIGINS below.

# Vite/Gateway bind host. Dev only; production builds are unaffected.
HOST=0.0.0.0

# Replace with the Mac's LAN IP (e.g. 192.168.1.20). The phone App must
# reach BOTH ports through this IP.
VITE_GATEWAY_BASE_URL=http://192.168.1.20:8787

# Comma-separated allowlist. Include both the LAN IP and any Capacitor /
# ionic / custom scheme the App shell will use. Wildcards are forbidden
# (see apps/gateway/src/cors.ts GHA-064).
GATEWAY_CORS_ORIGINS=http://192.168.1.20:5177,capacitor://localhost,http://localhost

# Optional: serve Vite over HTTPS so mobile WebView allows secure-context
# APIs. Requires mkcert on the Mac:
#   brew install mkcert && mkcert -install
#   mkcert 192.168.1.20
VITE_DEV_HTTPS=false
