{
  "name": "axi-docs-display",
  "version": "1.0.0",
  "description": "Axi Docs Display",
  "main": "main.js",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:ts": "tsc",
    "start": "tsc && electron .",
    "build": "tsc && electron-builder --win --x64",
    "build:android": "cd .. && pnpm run build && pnpm exec cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "cd .. && pnpm run build && pnpm exec cap sync android && cd android && ./gradlew assembleRelease",
    "sync:android": "pnpm exec cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "pack": "tsc && electron-builder --dir"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/device": "^8.0.1",
    "@capacitor/geolocation": "^6.1.1",
    "electron-log": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.axi.docs.display",
    "productName": "Axi Docs Display",
    "extends": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build",
        "to": "webapp"
      },
      {
        "from": "../../backend/dist/sop_server",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "../assets/logo-256X256.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false
    }
  }
}
