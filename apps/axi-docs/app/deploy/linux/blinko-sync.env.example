# Blinko mirror sync runtime
APP_DIR=/root/.hermes/apps/axi-docs/app
APP_ENV_FILE=/root/.hermes/apps/axi-docs/app/.env.server
BLINKO_SYNC_DIR=/srv/sync/blinko-notes
BLINKO_API_URL=http://127.0.0.1:1111/api/v1
BLINKO_ATTACHMENT_MAX_BYTES=104857600
BLINKO_OSS_UPLOAD_COMMAND='node ./scripts/blinko-oss-upload-hook.mjs'
BLINKO_OSS_PREFIX=blinko
BLINKO_OSS_PUBLIC_BASE_URL=

# Nutstore / WebDAV via rclone
BLINKO_RCLONE_REMOTE_NAME=nutstore
BLINKO_RCLONE_URL=
BLINKO_RCLONE_VENDOR=other
BLINKO_RCLONE_USER=
BLINKO_RCLONE_PASSWORD=
BLINKO_RCLONE_REMOTE_PATH=axi-docs/blinko-notes
RCLONE_TRANSFERS=4
