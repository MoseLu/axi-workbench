NODE_ENV=production
MCP_HTTP_PORT=3010
BIND_ADDRESS=0.0.0.0

# Primary knowledge root exposed as the default "obsidian" source
OBSIDIAN_PATH=/root/.hermes/knowledge

# Optional Blinko integration
BLINKO_URL=http://127.0.0.1:1111
BLINKO_TOKEN=
BLINKO_API_URL=http://127.0.0.1:1111/api/v1
BLINKO_SYNC_DIR=/srv/sync/blinko-notes
BLINKO_ATTACHMENT_MAX_BYTES=104857600
BLINKO_OSS_UPLOAD_COMMAND='node ./scripts/blinko-oss-upload-hook.mjs'
BLINKO_OSS_BUCKET=
BLINKO_OSS_PREFIX=blinko
BLINKO_OSS_PUBLIC_BASE_URL=
BLINKO_OSS_SIGNED_URL_EXPIRES_SECONDS=

# Reuse existing Axi OSS credentials if available
AXI_ALIYUN_OSS_ACCESS_KEY_ID=
AXI_ALIYUN_OSS_ACCESS_KEY_SECRET=
AXI_ALIYUN_OSS_PUBLIC_BUCKET=
AXI_ALIYUN_OSS_PRIVATE_BUCKET=
AXI_ALIYUN_OSS_REGION=
AXI_ALIYUN_OSS_ENDPOINT=
AXI_ALIYUN_OSS_STS_TOKEN=

# MiniMax-compatible analysis
MCP_ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-haiku-20241022

# Persistent token for /mcp HTTP access
MCP_AUTH_TOKEN=

# Extra Hermes-aware local sources
AXI_DOCS_EXTRA_SOURCES_JSON=[{"id":"hermes-system","name":"Hermes System","path":"/root/.hermes/memories","type":"local","enabled":true,"description":"Hermes 长期记忆与系统文档","icon":"folder"},{"id":"hermes-home","name":"Hermes Home","path":"/root/.hermes","type":"local","enabled":true,"description":"Hermes 全局文档与技能说明","icon":"folder"}]
