{
  "name": "axi-docs",
  "version": "1.0.0",
  "description": "文档同步与查看平台",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11",
      "body-parser": "2.3.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.6",
      "form-data": "4.0.6",
      "hono": "4.12.31",
      "ip-address": "10.3.1",
      "js-yaml@<3.15.2": "3.15.2",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash": "4.18.0",
      "path-to-regexp": "8.4.0",
      "qs": "6.15.2",
      "tmp": "0.2.7",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "urllib": "2.44.1",
      "undici": "7.29.0"
    }
  },
  "scripts": {
    "blinko:export": "node ./sync-blinko.js",
    "blinko:import": "node ./scripts/blinko-import-mirror.mjs",
    "blinko:oss-upload-hook": "node ./scripts/blinko-oss-upload-hook.mjs",
    "blinko:sync": "node ./scripts/blinko-sync-cycle.mjs",
    "branch:check": "node ./scripts/check-git-branch.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "commit": "pnpm exec cz",
    "commit:check:last": "pnpm exec commitlint --last --verbose",
    "commit:lint:range": "node ./scripts/check-commit-range.mjs",
    "docs:check": "node ./scripts/check-docs.mjs",
    "projects:build": "node ./scripts/build-projects-index.mjs",
    "projects:check": "node ./scripts/build-projects-index.mjs --check",
    "error-doc:lint": "node ./scripts/lint-error-doc.mjs",
    "rules-doc:lint": "node ./scripts/lint-rules-doc.mjs",
    "rule:check-fragmented-commits": "node ./scripts/check-fragmented-commits.mjs",
    "rule:check-naming-drift": "node ./scripts/check-naming-drift.mjs",
    "rule:check-mcp-log-dir": "node ./scripts/check-mcp-log-dir.mjs",
    "rule:check": "node ./scripts/run-all-rule-checks.mjs",
    "source:check": "node ./scripts/check-source-locks.mjs",
    "source:age": "node ./scripts/check-source-locks-age.mjs",
    "source:age:strict": "node ./scripts/check-source-locks-age.mjs --strict",
    "git:bootstrap": "node ./scripts/setup-git-governance.mjs",
    "governance:check": "pnpm branch:check && pnpm docs:check && pnpm error-doc:lint && pnpm rules-doc:lint && pnpm source:check",
    "hooks:install": "node ./scripts/install-hooks.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "pr:title:check": "node ./scripts/check-pr-title.mjs",
    "quality:check": "pnpm governance:check && pnpm lint && pnpm test:coverage",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/server.ts http",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ali-oss": "^6.23.0",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "three": "^0.183.2",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.24.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "commitizen": "^4.3.1",
    "cz-git": "^1.11.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
