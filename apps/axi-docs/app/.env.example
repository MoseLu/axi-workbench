# Axi Docs 环境变量配置

# ======================================
# 基础配置
# ======================================
# Vite API 基础路径
VITE_API_BASE=/api

# ======================================
# Obsidian 配置
# ======================================
# Obsidian Vault 路径
OBSIDIAN_PATH=./docs

# 额外知识源（JSON 数组，可追加 Hermes/system 等本地目录）
# 示例:
# AXI_DOCS_EXTRA_SOURCES_JSON=[{"id":"hermes-system","name":"Hermes System","path":"/root/.hermes/memories","type":"local","enabled":true,"description":"Hermes 长期记忆与系统文档","icon":"folder"}]
AXI_DOCS_EXTRA_SOURCES_JSON=

# Axi Skills 仓库路径
AXI_SKILLS_PATH=/Volumes/code/workspace/shared/axi-skills

# dbskill 完整工具箱来源，索引 skills、知识包、模板和内容工程脚手架
DBSKILL_PATH=/Volumes/code/workspace/shared/dbskill
DBSKILL_CONTENT_ASSETS_ENABLED=true

# ======================================
# Blinko 配置
# ======================================
# Blinko 服务地址
BLINKO_URL=http://localhost:1111

# Blinko v1 API 地址（同步脚本使用）
BLINKO_API_URL=http://localhost:1111/api/v1

# Blinko API Token
# 优先级：BLINKO_TOKEN 环境变量 > 空字符串（Blinko 关闭认证时）
# Docker 部署：在 docker-compose.yml 或 .env 文件中设置此值
# 本地开发：如 Blinko 开启认证，配置此值；如关闭认证，留空即可
BLINKO_TOKEN=

# Blinko Markdown 镜像目录
BLINKO_SYNC_DIR=./blinko-notes

# 附件策略：100MB 以内走 OSS，超过 100MB 仅保留本地源文件
BLINKO_ATTACHMENT_MAX_BYTES=104857600
BLINKO_OSS_UPLOAD_COMMAND=''
BLINKO_OSS_BUCKET=
BLINKO_OSS_PREFIX=blinko
BLINKO_OSS_PUBLIC_BASE_URL=
BLINKO_OSS_SIGNED_URL_EXPIRES_SECONDS=

# 阿里云 OSS（沿用 Axi 现有变量命名）
AXI_ALIYUN_OSS_ACCESS_KEY_ID=
AXI_ALIYUN_OSS_ACCESS_KEY_SECRET=
AXI_ALIYUN_OSS_PUBLIC_BUCKET=
AXI_ALIYUN_OSS_PRIVATE_BUCKET=
AXI_ALIYUN_OSS_REGION=
AXI_ALIYUN_OSS_ENDPOINT=
AXI_ALIYUN_OSS_STS_TOKEN=

# ======================================
# Anthropic AI 配置（用于 AI 文档分析）
# ======================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=claude-3-5-haiku-20241022

# ======================================
# MCP 服务器配置
# ======================================
# HTTP 服务绑定地址（仅本机: 127.0.0.1，或所有网卡: 0.0.0.0）
BIND_ADDRESS=127.0.0.1

# MCP HTTP 服务访问 Token（留空则自动生成并保存至 .axi-docs-token）
MCP_AUTH_TOKEN=

# 允许跨域请求的来源（逗号分隔，留空则开发模式允许所有）
# 示例: ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3005
ALLOWED_ORIGINS=

# Vite 开发服务器端口
VITE_PORT=3005
