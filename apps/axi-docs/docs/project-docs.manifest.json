  "summary": "Workspace documentation hub combining a React reader, knowledge-source adapters, knowledge graph, MCP document bus, and generated project dossier mirrors.",
  "readOrder": [
    "AGENTS.md",
    "README.md",
    "app/AGENTS.md",
    "docs/state/TODO.md",
    "docs/state/MILESTONE.md"
  ],
  "entrypoints": [
    {
      "id": "web-app",
      "path": "app/src/main.tsx",
      "purpose": "Mount the React documentation reader and knowledge hub."
    },
    {
      "id": "mcp-server",
      "path": "app/src/mcp/server.ts",
      "purpose": "Expose the Axi Docs MCP and HTTP document-access surfaces."
    },
    {
      "id": "project-dossier-builder",
      "path": "app/scripts/build-projects-index.mjs",
      "purpose": "Generate workspace project dossier mirrors and their index."
    },
    {
      "id": "source-lock-checker",
      "path": "app/scripts/check-source-locks.mjs",
      "purpose": "Validate external documentation source locks."
    }
  ],
  "commands": {
    "setup": [
      "pnpm --dir app install --frozen-lockfile"
    ],
    "start": [
      "pnpm --dir app dev",
      "pnpm --dir app mcp:http"
    ],
    "health": [
      "pnpm --dir app docs:check",
      "pnpm --dir app source:check"
    ],
    "verify": [
      "pnpm --dir app verify",
      "pnpm --dir app test:run",
      "pnpm --dir app rule:check"
    ],
    "smoke": [
      "pnpm --dir app docs:check",
      "pnpm --dir app verify"
    ]
  },
