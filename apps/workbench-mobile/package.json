{
  "name": "@axi/workbench-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test -c playwright.config.ts",
    "verify:contracts": "node scripts/verify-mobile-contracts.mjs"
  },
  "dependencies": {
    "@axi/core": "link:../../../../shared/axi-ui/packages/core",
    "@axi/tokens": "link:../../../../shared/axi-ui/packages/tokens",
    "@axi/workbench-foundation": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  },
  "description": "Axi Workbench Mobile application with an independent mobile information architecture"
}
