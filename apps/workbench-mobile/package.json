{
  "name": "@axi/workbench-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx",
    "e2e": "playwright test -c playwright.config.ts",
    "verify:contracts": "node scripts/verify-mobile-contracts.mjs",
    "verify:favicon-sync": "node scripts/check-favicon-sync.mjs"
  },
  "dependencies": {
    "@axi/core": "link:../../../../shared/axi-ui/packages/core",
    "@axi/observability-web": "workspace:*",
    "@axi/shell": "link:../../../../shared/axi-ui/packages/shell",
    "@axi/tokens": "link:../../../../shared/axi-ui/packages/tokens",
    "@axi/workbench-foundation": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  },
  "description": "Axi Workbench Mobile application with an independent mobile information architecture"
}
