{
  "name": "axi-fleet-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check:file-lines": "node scripts/check-file-lines.mjs",
    "check:file-lines:push": "node scripts/check-file-lines.mjs --push",
    "check:file-lines:staged": "node scripts/check-file-lines.mjs --staged",
    "prepare": "node scripts/install-git-hooks.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@axi/core": "link:../../../../../shared/axi-ui/packages/core",
    "@axi/crud": "link:../../../../../shared/axi-ui/packages/crud",
    "@axi/shell": "link:../../../../../shared/axi-ui/packages/shell",
    "@axi/tokens": "link:../../../../../shared/axi-ui/packages/tokens",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "postcss@<=8.5.22": "8.5.23"
    }
  }
}
