  "dependencies": {
    "@ant-design/icons": "^5.6.0",
    "@axi/core": "link:../../../../../shared/axi-ui/packages/core",
    "@axi/crud": "link:../../../../../shared/axi-ui/packages/crud",
    "@axi/shell": "link:../../../../../shared/axi-ui/packages/shell",
    "@axi/tokens": "link:../../../../../shared/axi-ui/packages/tokens",
    "antd": "^5.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
